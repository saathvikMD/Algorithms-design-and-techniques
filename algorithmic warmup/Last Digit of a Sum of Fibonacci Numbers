def Fibonochi(n):
    prev2 = 0
    prev1 = 1
    if n == 0:
        return prev2
    elif n == 1:
        return prev1
    else:
        reminder = n % 60
        if reminder == 0:
            return 0

        for i in range(2, reminder + 3):
            prev1, prev2 = (prev1 + prev2) % 60, prev1

        return str(prev1 - 1)[-1]

n = int(input())
print(Fibonochi(n))
